{
  "sampleRate": 44100,
  "previewOnly": true,
  "sets": [
    {
      "id": "A",
      "name": "圆润街机",
      "origin": "Kenney 官方 FPS Starter Kit＋Interface",
      "description": "短促、圆润，保留一点街机枪械的弹性；低频收住，不做真实枪炮的爆裂尾音。",
      "kind": "素材方案"
    },
    {
      "id": "B",
      "name": "轻机械卡通",
      "origin": "Kenney Impact＋Interface",
      "description": "偏木质、轻金属与扣合感，电子感较少；动作声音更柔，接近日常小物件的精简触感。",
      "kind": "素材方案"
    },
    {
      "id": "C",
      "name": "柔和电子",
      "origin": "Kenney Sci-Fi Sounds＋Interface",
      "description": "更干净的轻电子质感，柔化高频和长混响；保留四种枪不同的起音与重量。",
      "kind": "素材方案"
    },
    {
      "id": "D",
      "name": "暖色原创",
      "origin": "本次从零制作，无外部枪声采样",
      "description": "沿原版方向重做：暖而短的低频、轻敲击与少量平滑气流，减少白噪声，四种枪分别设计。",
      "kind": "原创方案"
    }
  ],
